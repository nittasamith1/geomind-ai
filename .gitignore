# Python virtual environments & bytecode caches
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
.venv/
venv/
ENV/

# Testing & Linting
.pytest_cache/
.coverage
htmlcov/

# IDE & Editor configs
.vscode/
.idea/
*.sublime-workspace
*.sublime-project

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Logs & OS artifacts
logs/*.log
*.log
.DS_Store
Thumbs.db
!logs/.gitkeep

# Environment variables & secrets
.env
.env.*
!.env.example

# Firebase service account keys & credentials (NEVER commit secrets)
*service-account*.json
*serviceAccount*.json
firebase-adminsdk*.json

# Processed data caches
data/processed/*.csv
!data/processed/.gitkeep

# Firebase CLI cache
.firebase/

# Firebase Storage local cache & telemetry
data/firebase_storage/
data/telemetry_predictions.json

# Scratch & deep learning binaries
models/*.pkl
models/dl/

# Large model binaries (>100MB exceeds standard GitHub file push limit)
# Note: Can be regenerated anytime via 'python run_pipeline.py' or synced via Firebase Storage
models/ml/random_forest.joblib

# Retain core production models in Git
!models/preprocessor.joblib
!models/val_results.csv
!models/ml/xgboost.joblib
!models/ml/ridge_regression.joblib
