# GeoMind Environment Configuration
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# Comma-separated allowed CORS origins
# Use your Firebase Hosting URL in production
CORS_ORIGINS=https://geomind---ai.web.app,https://geomind---ai.firebaseapp.com,http://localhost:8080,http://127.0.0.1:8080

# Google Cloud / Firebase Configuration
GCP_PROJECT_ID=geomind---ai
FIREBASE_PROJECT_ID=geomind---ai
FIREBASE_STORAGE_BUCKET=geomind---ai.firebasestorage.app

# Optional: Firestore collection for storing prediction logs
FIRESTORE_COLLECTION=predictions

