[Unit]
Description=GeoMind — AI Urban Traffic Forecasting FastAPI Service
After=network.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/GeoMind
Environment="PATH=/home/ubuntu/GeoMind/.venv/bin"
Environment="PYTHONUNBUFFERED=1"
Environment="ENVIRONMENT=production"
Environment="HOST=0.0.0.0"
Environment="PORT=8000"
Environment="LOG_LEVEL=INFO"
ExecStart=/home/ubuntu/GeoMind/.venv/bin/python -m uvicorn api.main:app --host 0.0.0.0 --port 8000 --workers 2 --no-access-log
Restart=always
RestartSec=5
KillMode=process
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
